{
  "name": "skyview-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live flights in a photorealistic 3D world",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "dev:api": "wrangler dev --config worker/wrangler.toml --local --persist-to .wrangler/state",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:mock": "vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "data:airports": "tsx scripts/build-airports.ts",
    "data:models": "tsx scripts/build-models.ts",
    "data:icons": "tsx scripts/build-icons.ts",
    "data:fixtures": "tsx scripts/record-fixtures.ts",
    "vapid:generate": "tsx scripts/generate-vapid.ts",
    "razorpay:plans": "tsx scripts/razorpay-create-plans.ts",
    "db:migrate:local": "wrangler d1 migrations apply skyview --local --config worker/wrangler.toml --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply skyview --remote --config worker/wrangler.toml",
    "deploy:api": "wrangler deploy --config worker/wrangler.toml",
    "deploy:web": "npm run build && wrangler pages deploy dist --project-name skyview-3d",
    "deploy": "npm run deploy:api && npm run deploy:web",
    "data:airport3d": "tsx scripts/build-airport3d.ts",
    "models:import": "tsx scripts/import-model.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "@supabase/supabase-js": "2.118.0",
    "cesium": "1.146.0",
    "jose": "6.2.12",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261022.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "happy-dom": "21.0.4",
    "meshoptimizer": "1.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-static-copy": "4.1.1",
    "vitest": "5.0.5",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "@cesium/engine": "26.4.0",
    "@cesium/widgets": "16.3.0"
  }
}
