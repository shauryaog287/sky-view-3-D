# ─────────────────────────────────────────────────────────────────────────────
# SkyView 3D — frontend environment (Vite). Copy to `.env.local` and fill in.
# Only VITE_* variables reach the browser. Never put server secrets here.
# Server secrets live in worker/.dev.vars (local) or `wrangler secret put` (prod).
# ─────────────────────────────────────────────────────────────────────────────

# "http" = talk to the Worker API at VITE_API_BASE; "mock" = in-browser simulator using recorded fixtures.
VITE_API_MODE=http
# Leave empty to use same-origin /api (Vite proxies /api to wrangler dev on :8787 in development).
VITE_API_BASE=

# Fallback launch mode used only until /api/config answers. The Worker's LAUNCH_MODE is the source of truth.
VITE_LAUNCH_MODE=open

# Cesium ion access token (World Terrain + imagery fallback). https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=

# Supabase (auth only). Public anon key is safe to expose; RLS protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push public VAPID key (generate with `npm run vapid:generate`). Public half only.
VITE_VAPID_PUBLIC_KEY=

# Analytics sink: none | self | plausible | posthog
VITE_ANALYTICS=self
VITE_PLAUSIBLE_DOMAIN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
